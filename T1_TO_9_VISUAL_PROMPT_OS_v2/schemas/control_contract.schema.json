{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://prompt-knowledge-os.local/schemas/control_contract.schema.json",
  "title":"Visual control contract",
  "type":"object","additionalProperties":false,
  "required":["schema_version","objective","controlled_axes","constraints","ownership_by_dimension","preservation_contract","allowed_dependent_changes","hard_gates","acceptance_checks"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "objective": {"type": "string", "minLength": 1},
    "controlled_axes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "ownership_by_dimension": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "preservation_contract": {
      "type": "object", "additionalProperties": false, "required": ["level", "regions"],
      "properties": {
        "level": {"enum": ["SEMANTIC", "STRUCTURAL", "PIXEL_EXACT", "UNKNOWN", "UNTESTED"]},
        "regions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["region", "level", "acceptance"], "properties": {"region": {"type": "string"}, "level": {"enum": ["SEMANTIC", "STRUCTURAL", "PIXEL_EXACT", "UNKNOWN", "UNTESTED"]}, "acceptance": {"type": "string"}}}}
      }
    },
    "allowed_dependent_changes": {"type": "array", "items": {"type": "string"}},
    "hard_gates": {"type": "array", "items": {"type": "string"}},
    "acceptance_checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "method", "pass_condition"], "properties": {"id": {"type": "string"}, "method": {"type": "string"}, "pass_condition": {"type": "string"}}}},
    "extensions": {"type": "object", "additionalProperties": true}
  }
}
