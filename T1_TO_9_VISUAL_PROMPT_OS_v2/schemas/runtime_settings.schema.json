{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://prompt-knowledge-os.local/schemas/runtime_settings.schema.json",
  "title":"Runtime settings negotiation",
  "type":"object","additionalProperties":false,
  "required":["schema_version","target_surface","main_model","image_tool_model","requested_settings","supported_settings","verification_sources","availability","omitted_settings_with_reason","actual_execution_status"],
  "properties":{
    "schema_version":{"type":"string","const":"1.0.0"},"target_surface":{"enum":["image_api","responses_api","ui","generic_tool"]},"main_model":{"type":"string","minLength":1},"image_tool_model":{"type":["string","null"]},"requested_settings":{"type":"object","additionalProperties":true},"supported_settings":{"type":"object","additionalProperties":true},"verification_sources":{"type":"array","items":{"type":"string"}},"availability":{"enum":["AVAILABLE","PARTIAL","UNKNOWN","UNAVAILABLE"]},"omitted_settings_with_reason":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["setting","reason"],"properties":{"setting":{"type":"string"},"reason":{"type":"string"}}}},"actual_execution_status":{"enum":["NOT_RUN","SETTINGS_ONLY","LIVE_VERIFIED","FAILED"]},"extensions":{"type":"object","additionalProperties":true}
  }
}
