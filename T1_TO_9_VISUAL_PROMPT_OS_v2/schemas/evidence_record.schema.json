{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://prompt-knowledge-os.local/schemas/evidence_record.schema.json",
  "title":"Evidence record",
  "type":"object","additionalProperties":false,
  "required":["schema_version","evidence_id","source_id","locator","claim_or_observation","evidence_class","scope","verification_status","observed_at","uncertainty","contradictions","supersedes","promotion_status"],
  "properties":{
    "schema_version":{"type":"string","const":"1.0.0"},"evidence_id":{"type":"string","pattern":"^E[A-Za-z0-9._-]+$"},"source_id":{"type":"string","minLength":1},"locator":{"type":"string","minLength":1},"claim_or_observation":{"type":"string","minLength":1},"quote":{"type":["string","null"]},
    "evidence_class":{"enum":["SOURCE_FACT","VISUAL_OBSERVATION","INFERENCE","HEURISTIC","ASSUMPTION"]},
    "evidence_method":{"enum":["DOCUMENTARY","RENDER","PROMPT","HUMAN_REVIEW","MACHINE_CHECK"]},
    "scope":{"type":"object","additionalProperties":false,"properties":{"model":{"type":"string"},"version":{"type":"string"},"surface":{"type":"string"},"task":{"type":"string"},"family":{"type":"string"},"region":{"type":"string"},"project":{"type":"string"}}},
    "verification_status":{"enum":["VERIFIED_PRIMARY","VERIFIED_OBSERVATION","SECONDARY_UNVERIFIED","CONFLICTING","UNAVAILABLE","NOT_APPLICABLE"]},"observed_at":{"type":"string","minLength":1},"uncertainty":{"type":"array","items":{"type":"string"}},"contradictions":{"type":"array","items":{"type":"string"}},"supersedes":{"type":"array","items":{"type":"string"}},"promotion_status":{"enum":["RAW","REVIEWED","TASK_SCOPED","FAMILY_SCOPED","PROJECT_SCOPED","UNIVERSAL_CANDIDATE","SUPERSEDED","REJECTED"]},"decision":{"type":"string"},"canonical_home":{"type":"string"},"test":{"type":"string"},"extensions":{"type":"object","additionalProperties":true}
  }
}
