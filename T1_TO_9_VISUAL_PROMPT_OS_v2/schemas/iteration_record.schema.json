{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://prompt-knowledge-os.local/schemas/iteration_record.schema.json",
  "title":"Controlled iteration record",
  "type":"object","additionalProperties":false,
  "required":["schema_version","run_id","attempt_id","parent_attempt","baseline_artifacts","hypothesis","changed_controls","held_controls","dependent_changes","outcomes","evidence_links","next_action"],
  "properties":{
    "schema_version":{"type":"string","const":"1.0.0"},"run_id":{"type":"string","minLength":1},"attempt_id":{"type":"string","minLength":1},"parent_attempt":{"type":["string","null"]},"baseline_artifacts":{"type":"array","minItems":1,"items":{"type":"string"}},"hypothesis":{"type":"object","additionalProperties":false,"required":["symptom","cause","falsifier"],"properties":{"symptom":{"type":"string"},"cause":{"type":"string"},"falsifier":{"type":"string"}}},"changed_controls":{"type":"array","minItems":1,"items":{"type":"string"}},"held_controls":{"type":"array","items":{"type":"string"}},"dependent_changes":{"type":"array","items":{"type":"string"}},"outcomes":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["criterion","result"],"properties":{"criterion":{"type":"string"},"result":{"enum":["PASS","FAIL","UNKNOWN","NOT_RUN"]},"evidence":{"type":"string"}}}},"evidence_links":{"type":"array","items":{"type":"string"}},"next_action":{"type":"string","minLength":1},"extensions":{"type":"object","additionalProperties":true}
  }
}
