{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://prompt-knowledge-os.local/schemas/delivery_manifest.schema.json",
  "title":"Delivery manifest",
  "type":"object","additionalProperties":false,
  "required":["schema_version","task_id","artifacts","provenance","acceptance_results","preservation_results","source_fingerprints","limitations","actual_execution_status"],
  "properties":{
    "schema_version":{"type":"string","const":"1.0.0"},"task_id":{"type":"string","minLength":1},"artifacts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["path","sha256","kind"],"properties":{"path":{"type":"string"},"sha256":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"},"kind":{"type":"string"}}}},"provenance":{"type":"object","minProperties":1,"additionalProperties":{"type":"string"}},"acceptance_results":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["check_id","status","evidence"],"properties":{"check_id":{"type":"string"},"status":{"enum":["PASS","FAIL","PARTIAL","NOT_RUN"]},"evidence":{"type":"string"}}}},"preservation_results":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["region","level","status"],"properties":{"region":{"type":"string"},"level":{"enum":["SEMANTIC","STRUCTURAL","PIXEL_EXACT","UNKNOWN","UNTESTED"]},"status":{"enum":["PASS","FAIL","PARTIAL","NOT_RUN"]}}}},"source_fingerprints":{"type":"object","additionalProperties":{"type":"string"}},"limitations":{"type":"array","items":{"type":"string"}},"actual_execution_status":{"enum":["NOT_RUN","PARTIAL","VERIFIED","FAILED"]},"extensions":{"type":"object","additionalProperties":true}
  }
}
