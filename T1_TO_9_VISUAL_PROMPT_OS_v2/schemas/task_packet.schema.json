{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://prompt-knowledge-os.local/schemas/task_packet.schema.json",
  "title":"Prompt task packet",
  "type":"object","additionalProperties":false,
  "required":["schema_version","task_id","mode","request","latest_corrections","explicit_overrides","reference_assignments","selected_families","output_contract","target_system","unresolved_questions"],
  "properties":{
    "schema_version":{"type":"string","const":"1.0.0"},"task_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "mode":{"enum":["new_generation","prompt_optimization","analysis_only","edit","debug","album","reference_guided","selected_frame","fusion"]},
    "request":{"type":"object","additionalProperties":false,"required":["objective"],"properties":{"objective":{"type":"string","minLength":1},"audience":{"type":"string"},"context":{"type":"string"},"message":{"type":"string"}}},
    "latest_corrections":{"type":"array","items":{"type":"string"}},"explicit_overrides":{"type":"object","additionalProperties":true},
    "reference_assignments":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["reference_id","assigned_roles"],"properties":{"reference_id":{"type":"string"},"assigned_roles":{"type":"array","minItems":1,"items":{"type":"string"}},"priority_by_dimension":{"type":"object","additionalProperties":{"type":"string"}}}}},
    "selected_families":{"type":"array","minItems":1,"maxItems":2,"items":{"type":"string"}},
    "output_contract":{"type":"object","additionalProperties":false,"required":["language","format","semantic_sections"],"properties":{"language":{"type":"string"},"format":{"type":"string"},"semantic_sections":{"type":"array","items":{"type":"string"}},"delivery_lane":{"enum":["GENERATIVE","HYBRID","DETERMINISTIC"]}}},
    "target_system":{"type":"object","additionalProperties":false,"required":["surface"],"properties":{"surface":{"type":"string"},"model":{"type":"string"},"version":{"type":"string"}}},
    "unresolved_questions":{"type":"array","items":{"type":"string"}},"extensions":{"type":"object","additionalProperties":true}
  },
  "examples":[{"schema_version":"1.0.0","task_id":"demo-001","mode":"analysis_only","request":{"objective":"Read the reference and report visible evidence"},"latest_corrections":[],"explicit_overrides":{},"reference_assignments":[],"selected_families":["none"],"output_contract":{"language":"vi-VN","format":"handoff","semantic_sections":[]},"target_system":{"surface":"generic"},"unresolved_questions":[]}]
}
