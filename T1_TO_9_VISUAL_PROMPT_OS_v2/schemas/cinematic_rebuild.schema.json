{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-knowledge-os.local/schemas/cinematic_rebuild.schema.json",
  "title": "Cinematic rebuild extension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "operation",
    "selection_status",
    "selected_direction_id",
    "decision_revision",
    "input_revision",
    "input_status",
    "dna",
    "directions",
    "shot_spec",
    "change_ledger",
    "latest_corrections",
    "open_questions"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "phase": {"enum": ["DISCUSS", "OPTIONS_READY", "DECIDED", "COMPILED", "CRITIQUE"]},
    "operation": {"type": "string", "const": "cinematic_rebuild"},
    "selection_status": {"enum": ["unselected", "user_selected", "delegated"]},
    "selected_direction_id": {"type": ["string", "null"]},
    "decision_revision": {"type": "integer"},
    "input_revision": {"type": "string", "minLength": 1},
    "input_status": {"enum": ["IMAGE_OBSERVED", "DESCRIPTION_ONLY", "PROMPT_ONLY"]},
    "family_status": {"enum": ["none", "proposed", "resolved"]},
    "dna": {"$ref": "#/$defs/dna_card"},
    "directions": {
      "type": "array",
      "items": {"$ref": "#/$defs/direction"}
    },
    "shot_spec": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["shot_id", "decision_revision", "selection_status", "selected_direction", "intent", "moment", "invariants", "changes_from_reference"],
      "properties": {
        "shot_id": {"type": "string", "minLength": 1},
        "decision_revision": {"type": "integer"},
        "selection_status": {"enum": ["unselected", "user_selected", "delegated"]},
        "selected_direction": {"type": "string", "minLength": 1},
        "intent": {"type": "string", "minLength": 1},
        "moment": {"type": "string", "minLength": 1},
        "invariants": {"type": "array", "items": {"type": "string"}},
        "changes_from_reference": {
          "type": "array",
          "items": {"$ref": "#/$defs/change_row"}
        },
        "performance": {"type": "object", "additionalProperties": true},
        "viewer_relation": {"type": "object", "additionalProperties": true},
        "camera": {"type": "object", "additionalProperties": true},
        "space": {"type": "object", "additionalProperties": true},
        "attention": {"type": "object", "additionalProperties": true},
        "lighting": {"type": "object", "additionalProperties": true},
        "render_domains": {"type": "array", "items": {"type": "string"}},
        "intentional_impossibility": {"type": ["string", "null"]},
        "target_generator": {"type": "string"},
        "output_contract": {"type": "string"},
        "acceptance_cues": {"type": "array", "items": {"type": "string"}}
      }
    },
    "change_ledger": {
      "type": "array",
      "items": {"$ref": "#/$defs/change_row"}
    },
    "latest_corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "applies_to_revision"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "applies_to_revision": {"type": "integer"},
          "invalidates_derived": {"type": "boolean"}
        }
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "dna_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "relational_signature", "emotional_register", "world_material_grammar", "render_boundaries", "attention_logic", "palette_roles", "signature_mechanism", "decisions", "uncertainties", "forbidden_drift"],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "evidence"],
          "properties": {
            "policy": {"enum": ["lock_if_assigned", "open", "drop"]},
            "evidence": {"type": "array", "items": {"type": "string"}}
          }
        },
        "relational_signature": {"type": "array", "items": {"type": "string"}},
        "emotional_register": {"type": "array", "items": {"type": "string"}},
        "world_material_grammar": {"type": "array", "items": {"type": "string"}},
        "render_boundaries": {"type": "array", "items": {"type": "string"}},
        "attention_logic": {"type": "array", "items": {"type": "string"}},
        "palette_roles": {"type": "array", "items": {"type": "string"}},
        "signature_mechanism": {"type": "array", "items": {"type": "string"}},
        "decisions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["carry", "lock", "translate", "repair", "drop", "open"],
          "properties": {
            "carry": {"type": "array", "items": {"type": "string"}},
            "lock": {"type": "array", "items": {"type": "string"}},
            "translate": {"type": "array", "items": {"type": "string"}},
            "repair": {"type": "array", "items": {"type": "string"}},
            "drop": {"type": "array", "items": {"type": "string"}},
            "open": {"type": "array", "items": {"type": "string"}}
          }
        },
        "uncertainties": {"type": "array", "items": {"type": "string"}},
        "forbidden_drift": {"type": "array", "items": {"type": "string"}}
      }
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "treatment", "dna_kept_or_translated", "structural_change", "why_it_fits", "cost"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "treatment": {"type": "string", "minLength": 1},
        "dna_kept_or_translated": {"type": "string", "minLength": 1},
        "structural_change": {"type": "string", "minLength": 1},
        "why_it_fits": {"type": "string", "minLength": 1},
        "cost": {"type": "string", "minLength": 1},
        "recommended": {"type": "boolean"}
      }
    },
    "change_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "before", "after", "reason"],
      "properties": {
        "dimension": {"enum": ["staging", "station", "gaze", "spatial_relation", "first_read", "action", "light", "palette", "identity", "render_boundary", "other"]},
        "before": {"type": "string", "minLength": 1},
        "after": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
